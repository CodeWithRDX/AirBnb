# ==========================================
# Deployment-Ready .gitignore for Airbnb Clone
# Monorepo: Django Backend + Next.js Frontend
# ==========================================

# ------------------------------------------
# Environment & Secrets (NEVER COMMIT SECRETS)
# ------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.crt

# ------------------------------------------
# Python & Django (Backend)
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django local database & runtime files
*.sqlite3
*.sqlite3-journal
db.sqlite3
/backend/db.sqlite3
/backend/staticfiles/
/backend/static_root/
/backend/media/
media/
staticfiles/

# Pytest / Coverage / Linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# ------------------------------------------
# Node.js & Next.js (Frontend)
# ------------------------------------------
# Dependencies
node_modules/
/frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
.next/
/frontend/.next/
out/
/frontend/out/
build/
/frontend/build/
dist/
/frontend/dist/

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# Testing & Coverage
coverage/
/frontend/coverage/

# Vercel & Deployment local state
.vercel/

# TypeScript build info
*.tsbuildinfo
frontend/next-env.d.ts

# ------------------------------------------
# IDE & Code Editors
# ------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.settings/

# ------------------------------------------
# OS Generated Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------
# Docker & Temporary Files
# ------------------------------------------
*.tmp
*.temp
.cache/
